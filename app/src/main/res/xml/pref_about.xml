<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:title="@string/about">

	<Preference
		android:key="about_app_info"
		android:title="Nyora"
		android:summary="Version 1.0 beta"
		android:persistent="false" />

	<Preference
		android:key="about_parser_info"
		android:title="@string/source_catalogue"
		android:summary="@string/checking_for_updates"
		android:persistent="false" />

	<Preference
		android:title="Official website"
		android:summary="nyora.pages.dev"
		android:persistent="false">
		<intent
			android:action="android.intent.action.VIEW"
			android:data="https://nyora.pages.dev" />
	</Preference>

	<Preference
		android:icon="@drawable/ic_about_github"
		android:title="Source code"
		android:summary="Hasan72341/nyora-android"
		android:persistent="false">
		<intent
			android:action="android.intent.action.VIEW"
			android:data="https://github.com/Hasan72341/nyora-android" />
	</Preference>

	<PreferenceCategory android:title="Developer">

		<Preference
			android:key="about_developer"
			android:icon="@drawable/ic_about_developer"
			android:title="Md Hasan Raza"
			android:summary="Creator of Nyora"
			android:persistent="false" />

		<Preference
			android:icon="@drawable/ic_about_instagram"
			android:title="Instagram"
			android:summary="@md_hasan_raza____"
			android:persistent="false">
			<intent
				android:action="android.intent.action.VIEW"
				android:data="https://www.instagram.com/md_hasan_raza____?igsh=MXZ6eTk2Y3FsNGs3aQ==" />
		</Preference>

		<Preference
			android:icon="@drawable/ic_about_linkedin"
			android:title="LinkedIn"
			android:summary="md-hasan-raza"
			android:persistent="false">
			<intent
				android:action="android.intent.action.VIEW"
				android:data="https://www.linkedin.com/in/md-hasan-raza-8817372a7/" />
		</Preference>

		<Preference
			android:icon="@drawable/ic_about_github"
			android:title="GitHub"
			android:summary="Hasan72341"
			android:persistent="false">
			<intent
				android:action="android.intent.action.VIEW"
				android:data="https://github.com/Hasan72341" />
		</Preference>

		<Preference
			android:icon="@drawable/ic_about_email"
			android:title="Email"
			android:summary="hasanraza96@outlook.com"
			android:persistent="false">
			<intent
				android:action="android.intent.action.VIEW"
				android:data="mailto:hasanraza96@outlook.com" />
		</Preference>

	</PreferenceCategory>

	<Preference
		android:summary="Nyora — your manga library, everywhere. Available on Android, Windows, macOS, Linux, iOS and the web."
		android:selectable="false"
		android:persistent="false" />

</PreferenceScreen>
